{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$(ls ~/dotfiles/.config/fastfetch/pngs/*.png | shuf -n 1)",
        "height": 12
    },
  "modules": [
    "os",
    "kernel",
    "packages",
    "theme",
    "terminal",
    "terminalfont",
    {"type":"cpu", "temp": true},
    "gpu",
    "publicip",
    "localip",
    "battery",
  ]
}
